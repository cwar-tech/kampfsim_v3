        "Ziel wird zerstört",
        "Kein weiteres Ziel vorhanden"
      ],
      "attacker": [
        {
          "unitTypeId": "ship_destroyer",
          "count": 5000
        }
      ],
      "defender": [
        {
          "unitTypeId": "ship_light_fighter",
          "count": 10
        }
      ]
    },
